# Copy to .env (gitignored) and uncomment the lines to send welcome mails
# through a real SMTP server. While SMTP_HOST is unset, the app sends to a
# free Ethereal test inbox and logs a preview URL instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Galactic Command <you@example.com>"
