# Manual API walkthrough for the Spacefarer service.
#
# 1. Start the app:  pnpm install && pnpm start
# 2. Open this file in VS Code (REST Client extension) and send the requests top to bottom.
#
# Users (development only, defined in package.json):
#   alice  Commander  EARTH     bob   Commander  MARS
#   carol  Cadet      EARTH     dave  no role
# Each request states its expected status. Data lives in memory, so restart the app to reset it.
#
# Spacefarers use Fiori drafts: a POST creates a draft, and "draftActivate" saves it.
# Validation and the create handlers (stardust bonus, welcome email) run on activation.

@server = http://localhost:4004
@api = {{server}}/spacefarers
@newId = 33333333-3333-3333-3333-333333333333
@marsId = 44444444-4444-4444-4444-444444444444
@badId = 55555555-5555-5555-5555-555555555555
@aliceId = 11111111-1111-1111-1111-111111111111
@bobId = 22222222-2222-2222-2222-222222222222


################################################################################
### 1. Read: each user only sees spacefarers from their own planet
################################################################################

### Alice (Earth) sees only Earth's spacefarers (23 rows). Expect 200
GET {{api}}/Spacefarers
Authorization: Basic alice:alice

### Bob (Mars) sees only Mars's spacefarers (12 rows). Expect 200
GET {{api}}/Spacefarers
Authorization: Basic bob:bob

### Department is derived from the position. Expect 200
GET {{api}}/Spacefarers?$select=name,stardust&$expand=position($select=name),department($select=name)
Authorization: Basic alice:alice

### Sorting, filtering and paging are plain OData query options. Expect 200
GET {{api}}/Spacefarers?$filter=stardust%20gt%2050&$orderby=stardust%20desc&$top=10&$skip=0&$count=true
Authorization: Basic alice:alice


################################################################################
### 2. Create, update, delete (as a Commander on their own planet)
################################################################################

### Create a draft. Expect 201
POST {{api}}/Spacefarers
Content-Type: application/json
Authorization: Basic alice:alice

{
  "ID": "{{newId}}",
  "name": "Nova Rider",
  "email": "nova@example.com",
  "stardust": 10,
  "wormholeNavigationSkill": 3,
  "spacesuitColor_code": "orange",
  "originPlanet_code": "EARTH",
  "position_code": "PILOT"
}

### Save the draft. Runs the create handlers and sends the welcome email, see the previewUrl in the server log. Expect 201
POST {{api}}/Spacefarers(ID={{newId}},IsActiveEntity=false)/draftActivate
Content-Type: application/json
Authorization: Basic alice:alice

{}

### Read it back. Stardust is 110: 10 sent plus the 100 welcome bonus. Expect 200
GET {{api}}/Spacefarers(ID={{newId}},IsActiveEntity=true)
Authorization: Basic alice:alice

### Update the saved record directly. Expect 200
PATCH {{api}}/Spacefarers(ID={{newId}},IsActiveEntity=true)
Content-Type: application/json
Authorization: Basic alice:alice

{
  "stardust": 250,
  "spacesuitColor_code": "silver"
}

### Delete. Expect 204
DELETE {{api}}/Spacefarers(ID={{newId}},IsActiveEntity=true)
Authorization: Basic alice:alice

### It is gone. Expect 404
GET {{api}}/Spacefarers(ID={{newId}},IsActiveEntity=true)
Authorization: Basic alice:alice


################################################################################
### 3. Security: who may do what
################################################################################

### No login. Expect 401
GET {{api}}/Spacefarers

### Logged in but no role. Expect 403
GET {{api}}/Spacefarers
Authorization: Basic dave:dave

### A Cadet can read. Expect 200
GET {{api}}/Spacefarers
Authorization: Basic carol:carol

### A Cadet cannot create. Expect 403
POST {{api}}/Spacefarers
Content-Type: application/json
Authorization: Basic carol:carol

{
  "name": "Cadet Attempt",
  "email": "cadet@example.com",
  "originPlanet_code": "EARTH"
}

### Another planet's spacefarer is invisible (Alice asks for Bob). Expect 404
GET {{api}}/Spacefarers(ID={{bobId}},IsActiveEntity=true)
Authorization: Basic alice:alice

### ...and cannot be edited. Expect 403
POST {{api}}/Spacefarers(ID={{bobId}},IsActiveEntity=true)/SpacefarerService.draftEdit
Content-Type: application/json
Authorization: Basic alice:alice

{
  "PreserveChanges": true
}

### ...or changed directly. Expect 403
PATCH {{api}}/Spacefarers(ID={{bobId}},IsActiveEntity=true)
Content-Type: application/json
Authorization: Basic alice:alice

{
  "stardust": 9999
}

### Alice starts a spacefarer on Mars. A draft may hold anything. Expect 201
POST {{api}}/Spacefarers
Content-Type: application/json
Authorization: Basic alice:alice

{
  "ID": "{{marsId}}",
  "name": "Wrong Planet",
  "email": "wrong@example.com",
  "originPlanet_code": "MARS"
}

### ...but saving it is refused. Expect 403
POST {{api}}/Spacefarers(ID={{marsId}},IsActiveEntity=false)/draftActivate
Content-Type: application/json
Authorization: Basic alice:alice

{}

### Alice cannot move her own spacefarer to Mars. Expect 403
PATCH {{api}}/Spacefarers(ID={{aliceId}},IsActiveEntity=true)
Content-Type: application/json
Authorization: Basic alice:alice

{
  "originPlanet_code": "MARS"
}


################################################################################
### 4. Validation
################################################################################

### Unknown suit color. Expect 400
PATCH {{api}}/Spacefarers(ID={{aliceId}},IsActiveEntity=true)
Content-Type: application/json
Authorization: Basic alice:alice

{
  "spacesuitColor_code": "purple"
}

### Malformed email. Expect 400
PATCH {{api}}/Spacefarers(ID={{aliceId}},IsActiveEntity=true)
Content-Type: application/json
Authorization: Basic alice:alice

{
  "email": "not-an-email"
}

### Unknown position. Expect 400
PATCH {{api}}/Spacefarers(ID={{aliceId}},IsActiveEntity=true)
Content-Type: application/json
Authorization: Basic alice:alice

{
  "position_code": "NOPE"
}

### Origin planet cannot be removed. Expect 400
PATCH {{api}}/Spacefarers(ID={{aliceId}},IsActiveEntity=true)
Content-Type: application/json
Authorization: Basic alice:alice

{
  "originPlanet_code": null
}

### Negative stardust is rejected on edits too. Expect 400
PATCH {{api}}/Spacefarers(ID={{aliceId}},IsActiveEntity=true)
Content-Type: application/json
Authorization: Basic alice:alice

{
  "stardust": -50
}

### Skill above 10 is rejected on edits too. Expect 400
PATCH {{api}}/Spacefarers(ID={{aliceId}},IsActiveEntity=true)
Content-Type: application/json
Authorization: Basic alice:alice

{
  "wormholeNavigationSkill": 11
}

### The same rules apply when a new spacefarer is saved. Draft with negative stardust. Expect 201
POST {{api}}/Spacefarers
Content-Type: application/json
Authorization: Basic alice:alice

{
  "ID": "{{badId}}",
  "name": "Dust Debt",
  "email": "debt@example.com",
  "stardust": -5,
  "wormholeNavigationSkill": 11
}

### ...saving it is refused (negative stardust, skill above 10). Expect 400
POST {{api}}/Spacefarers(ID={{badId}},IsActiveEntity=false)/draftActivate
Content-Type: application/json
Authorization: Basic alice:alice

{}


################################################################################
### 5. Lookup data (read-only, for dropdowns). Expect 200
################################################################################

### Suit colors
GET {{api}}/SuitColors
Authorization: Basic alice:alice

### Planets
GET {{api}}/Planets
Authorization: Basic alice:alice

### Departments
GET {{api}}/Departments
Authorization: Basic alice:alice

### Positions
GET {{api}}/Positions
Authorization: Basic alice:alice
